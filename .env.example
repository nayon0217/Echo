# Copy to .env and fill in the secrets:
#   cp .env.example .env

# --- WhatsApp Cloud API ---
number_ID=
access_token=
VERIFY_TOKEN=echo_verify_token
PORT=3000
GRAPH_API_VERSION=v21.0

# --- Pipeline (Python FastAPI the Node bot calls) ---
PIPELINE_URL=http://127.0.0.1:8000
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# --- Postgres (docker compose defaults) ---
# DATABASE_URL=postgresql://echo:echo@localhost:5432/echo
POSTGRES_USER=echo
POSTGRES_PASSWORD=echo
POSTGRES_DB=echo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Optional ---
# WHISPER_MODEL=base          # default is large-v3 (~3 GB); use base while iterating
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
